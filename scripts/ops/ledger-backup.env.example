# Copy to /etc/renovation-ledger-backup.env (mode 600). Without COS_* local dumps still run.
BACKUP_DIR=/var/backups/renovation-ledger
KEEP_DAYS=14

# 腾讯云 COS（上海）。控制台创建私有桶后填写：
# COS_BUCKET=renovation-ledger-backup-xxxxxxxx
# COS_REGION=ap-shanghai
# COS_ENDPOINT=cos.ap-shanghai.myqcloud.com
# COS_PREFIX=ledger-pg
# COS_SECRET_ID=
# COS_SECRET_KEY=
